# Copy to .env in the project root. Keep credentials out of source control.
SMS_ENABLED=false
SMS_PROVIDER=smslenz
SMSLENZ_USER_ID=
SMSLENZ_API_KEY=
SMSLENZ_SENDER_ID=SMSlenzDEMO
# Limit automatic samples to four submissions per backend run. 0 means unlimited.
SMS_MAX_MESSAGES_PER_SESSION=4
# Sri Lankan local mobile numbers or international +countrycode numbers, comma separated.
SMS_RECIPIENTS=
# Optional alternative: select SMS_PROVIDER=twilio to use these credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a registered alphanumeric sender ID for Sri Lankan networks that require one.
TWILIO_FROM=
# Alternatively, use a Messaging Service with an appropriate registered sender.
TWILIO_MESSAGING_SERVICE_SID=
SMS_COOLDOWN_SECONDS=300
SMS_FAILURE_BACKOFF_SECONDS=60
SMS_HTTP_TIMEOUT_SECONDS=10
SMS_SITE_NAME=Vision Sentry
